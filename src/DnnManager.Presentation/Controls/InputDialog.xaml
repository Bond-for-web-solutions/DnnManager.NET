<Window x:Class="DnnManager.Presentation.Controls.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNN Manager" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Question" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
        <TextBox x:Name="Text" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="OK" Style="{StaticResource Primary}" MinWidth="80" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
