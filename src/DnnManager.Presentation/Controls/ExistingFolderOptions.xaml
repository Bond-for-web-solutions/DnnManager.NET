<UserControl x:Class="DnnManager.Presentation.Controls.ExistingFolderOptions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <!-- Website + database first and pre-selected: the usual case for a folder that's already there. -->
        <RadioButton x:Name="IisAndDatabase" GroupName="ExistingAction" Content="Keep the files - set up the IIS website + local database" IsChecked="True" Checked="Action_Checked" />
        <RadioButton x:Name="DatabaseOnly"   GroupName="ExistingAction" Content="Keep the files - set up the local database only" Checked="Action_Checked" />
        <RadioButton x:Name="IisOnly"        GroupName="ExistingAction" Content="Keep the files - set up the IIS website only" Checked="Action_Checked" />
        <RadioButton x:Name="Redownload"     GroupName="ExistingAction" Content="Download DNN into the folder (overwrites files)" Checked="Action_Checked" Visibility="Collapsed" />

        <!-- Visible from the start because the default choice includes the database. -->
        <StackPanel x:Name="BackupPanel" Margin="0,8,0,0">
            <TextBlock Style="{StaticResource FieldLabel}" Text="Restore a .bacpac / .bak into the database" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="Browse_Click" />
                <ComboBox x:Name="BackupCombo" DisplayMemberPath="Label" />
            </DockPanel>
            <TextBlock Style="{StaticResource Hint}" Text="Backups are looked up in the project's backups folder and its root, newest first." />
        </StackPanel>
    </StackPanel>
</UserControl>
