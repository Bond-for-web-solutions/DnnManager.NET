<UserControl x:Class="DnnManager.Presentation.Pages.PrerequisitesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,20" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Prerequisites" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Checks that Docker is available and that the Windows features IIS needs to host DNN are enabled - and offers to enable the missing ones." />

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="What gets checked" />
                    <TextBlock Text="Docker - runs the shared SQL Server container." Margin="0,0,0,12" />
                    <TextBlock Text="IIS Windows features" FontWeight="SemiBold" Margin="0,0,0,6" />

                    <!-- A plain two-column table (a DataGrid here would swallow the page's mouse-wheel scrolling). -->
                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4" Grid.IsSharedSizeScope="True">
                        <StackPanel>
                            <Border Background="{DynamicResource HeaderBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1"
                                    CornerRadius="4,4,0,0" Padding="12,7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="Feature" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Feature" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Grid.Column="2" Text="Windows feature name" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" />
                                </Grid>
                            </Border>
                            <ItemsControl x:Name="FeatureList" AlternationCount="100000">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="Row" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,1,0,0" Padding="12,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Feature" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" />
                                                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{DynamicResource TextMuted}"
                                                           FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <!-- No divider above the first row - the header already has one. -->
                                            <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                                                <Setter TargetName="Row" Property="BorderThickness" Value="0" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Primary}" Content="Run checks" Click="Run_Click" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
