<UserControl x:Class="DnnManager.Presentation.Pages.ExistingFolderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls">
    <DockPanel Margin="28,24,28,20">
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource PageTitle}" Text="Existing folder" />
                <!-- Explains what setting up the website does to HTTPS redirect rules in web.config. -->
                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,4,0,0"
                           Cursor="Help" Background="Transparent" ToolTipService.InitialShowDelay="200"
                           ToolTipService.ShowDuration="60000">
                    <TextBlock.ToolTip>
                        <StackPanel MaxWidth="440">
                            <TextBlock Text="HTTPS redirects in web.config" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Setting up the IIS website also checks web.config for URL Rewrite rules that redirect every request to https:// - common on a production site. The local site has no HTTPS, so such a rule would make it unreachable." />
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,6"
                                       Text="Those rules are switched off (enabled=&quot;false&quot;), not deleted, with a &quot;Disabled by DNN Manager&quot; comment above each one in web.config." />
                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource LogWarn}"
                                       Text="&#x26A0; The Activity log then warns you: switch them back on before deploying the site to production." />
                        </StackPanel>
                    </TextBlock.ToolTip>
                </TextBlock>
            </StackPanel>
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Set up the IIS website and/or the local database for a project folder that already exists." />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0" Margin="0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="Project folders" Margin="14,12,14,8" />
                    <ListBox x:Name="FolderList" BorderThickness="0" SelectionChanged="FolderList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,4">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Iis}" Foreground="{DynamicResource TextMuted}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="EmptyText" Foreground="{DynamicResource TextMuted}" Text="Select a folder on the left." Margin="0,6,0,0" />
                    <Border x:Name="OptionsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" x:Name="OptionsTitle" />
                            <TextBlock x:Name="NameError" Style="{StaticResource ErrorLine}" Visibility="Collapsed" Margin="0,0,0,8" />
                            <c:ExistingFolderOptions x:Name="FolderOptions" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="RunButton" Style="{StaticResource Primary}" Content="Set up" IsEnabled="False" Click="Run_Click" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
