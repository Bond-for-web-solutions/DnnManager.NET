<UserControl x:Class="DnnManager.Presentation.Pages.ClonePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,20">
            <TextBlock Style="{StaticResource PageTitle}" Text="Clone project" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Copies a DNN site from a local folder or an FTP server into a new project, restores its database into the local SQL Server container and creates the IIS website." />

            <!-- Source kind -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Source" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LocalRadio" GroupName="Kind" Content="Local folder" IsChecked="True" Checked="Changed" Margin="0,4,24,4" />
                        <RadioButton x:Name="FtpRadio"   GroupName="Kind" Content="FTP server" Checked="Changed" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Target project -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Project" />

                    <StackPanel x:Name="SavedProjectPanel">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Live site" Margin="0,0,0,4" />
                        <ComboBox x:Name="SavedProjectCombo" DisplayMemberPath="Label" SelectionChanged="Changed" />
                    </StackPanel>

                    <StackPanel x:Name="NamePanel">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="New project name" />
                        <TextBox x:Name="NameBox" TextChanged="Changed" />
                        <TextBlock x:Name="NameError" Style="{StaticResource ErrorLine}" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="ActionPanel" Margin="0,8,0,0">
                        <TextBlock x:Name="SavedSummary" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <RadioButton x:Name="ActionFull"  GroupName="Action" Content="Clone - website files + database" IsChecked="True" />
                        <RadioButton x:Name="ActionFiles" GroupName="Action" Content="Overwrite website files only" />
                        <RadioButton x:Name="ActionDb"    GroupName="Action" Content="Overwrite database only" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Local source -->
            <Border x:Name="LocalCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Source project" />
                    <ComboBox x:Name="LocalSourceCombo" SelectionChanged="Changed" />
                    <TextBlock x:Name="LocalHint" Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <!-- FTP source -->
            <Border x:Name="FtpCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="FTP connection" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Host" Margin="0,0,0,4" />
                            <TextBox x:Name="FtpHost" TextChanged="FtpField_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Port" Margin="0,0,0,4" />
                            <TextBox x:Name="FtpPort" Text="21" TextChanged="FtpField_Changed" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="User" />
                            <TextBox x:Name="FtpUser" TextChanged="FtpField_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
                            <c:PasswordInput x:Name="FtpPassword" PasswordChanged="FtpField_Changed" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="ConnectButton" Content="Connect &amp; browse" Click="Connect_Click" />
                        <TextBlock x:Name="FtpStatus" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="BrowserPanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" x:Name="UpButton" Content="↑ Up" Padding="10,4" Click="Up_Click" />
                            <TextBlock x:Name="CwdText" VerticalAlignment="Center" Margin="10,0,0,0" FontFamily="Cascadia Mono, Consolas" />
                        </DockPanel>
                        <ListBox x:Name="FtpDirs" Height="180" Margin="0,8,0,0" MouseDoubleClick="FtpDirs_DoubleClick" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Double-click a folder to open it. The folder shown above is the one that gets cloned - open the DNN site's root (the folder with web.config)." />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Source database -->
            <Border x:Name="SqlCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Source database credentials" />
                    <RadioButton x:Name="SqlSaved"     GroupName="Sql" Checked="Changed" Visibility="Collapsed" />
                    <RadioButton x:Name="SqlWebConfig" GroupName="Sql" Content="Use the credentials from the source's web.config" IsChecked="True" Checked="Changed" />
                    <RadioButton x:Name="SqlNew"       GroupName="Sql" Content="New SQL connection (saved for this project)" Checked="Changed" />

                    <StackPanel x:Name="SqlNewPanel" Visibility="Collapsed" Margin="22,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="SQL server" />
                                <TextBox x:Name="SqlServer" TextChanged="Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Port" />
                                <TextBox x:Name="SqlPort" Text="1433" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Database name" />
                        <TextBox x:Name="SqlDatabase" TextChanged="Changed" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="User" />
                                <TextBox x:Name="SqlUser" TextChanged="Changed" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
                                <c:PasswordInput x:Name="SqlPassword" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="RunButton" Style="{StaticResource Primary}" Content="Start clone" IsEnabled="False" Click="Run_Click" />
                <TextBlock x:Name="RunHint" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
