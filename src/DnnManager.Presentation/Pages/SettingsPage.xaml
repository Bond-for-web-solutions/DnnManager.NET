<UserControl x:Class="DnnManager.Presentation.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,20" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" />
            <TextBlock Style="{StaticResource PageSubtitle}" x:Name="Subtitle" />

            <Border x:Name="RestartBanner" Style="{StaticResource InfoBanner}" Visibility="Collapsed">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Restart now" Click="Restart_Click" />
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                               Text="Saved settings take effect the next time DNN Manager starts." />
                </DockPanel>
            </Border>

            <Border x:Name="EnvWarning" Style="{StaticResource WarnBanner}" Visibility="Collapsed">
                <TextBlock x:Name="EnvWarningText" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Projects" />
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Projects folder" Margin="0,0,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="BrowseBaseDir_Click" />
                        <TextBox x:Name="BaseDirectory" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="Every project is a folder in here." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Hostname suffix" />
                            <TextBox x:Name="HostnameSuffix" TextChanged="Preview_Changed" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Site port" />
                            <TextBox x:Name="SitePort" TextChanged="Preview_Changed" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="UrlPreview" Style="{StaticResource Hint}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="DNN release sources" />
                    <TextBox x:Name="ReleaseApis" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="70"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                    <TextBlock Style="{StaticResource Hint}" Text="GitHub releases API URLs, one per line - offered as the DNN source when setting up a new project." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="SQL Server container" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,-4,0,4"
                               Text="Container name, IP, volume, SA password and port must match the docker-compose.yml next to the app." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Container name" />
                            <TextBox x:Name="ContainerName" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Container IP" />
                            <TextBox x:Name="ContainerIp" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Volume name" />
                            <TextBox x:Name="VolumeName" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="SA password" />
                            <c:PasswordInput x:Name="SaPassword" />
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Default port" />
                            <TextBox x:Name="DefaultPort" />
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Collation" />
                            <TextBox x:Name="Collation" />
                        </StackPanel>
                        <StackPanel Grid.Row="3">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Edition (MSSQL_PID)" />
                            <TextBox x:Name="MssqlPid" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Database name suffix" />
                            <TextBox x:Name="DbNameSuffix" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorLine}" Visibility="Collapsed" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Primary}" Content="Save" MinWidth="90" Click="Save_Click" />
                <Button Content="Revert" Margin="8,0,0,0" Click="Revert_Click" />
                <Button Content="Open appsettings.json" Margin="8,0,0,0" Click="OpenFile_Click" />
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                       Text="The IIS feature list and logging levels are edited in appsettings.json directly." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
