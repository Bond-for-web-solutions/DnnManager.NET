<UserControl x:Class="DnnManager.Presentation.Pages.ConnectionsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DnnManager.Presentation.Controls">
    <DockPanel Margin="28,24,28,20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{StaticResource PageTitle}" Text="Live sites" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="The FTP and SQL connections of your live websites - used to clone them. Passwords are stored encrypted." />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0" Margin="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,10,10,8">
                        <Button DockPanel.Dock="Right" Content="+ Add" Padding="10,2" MinHeight="26" Click="Add_Click"
                                ToolTip="Add a live site" />
                        <TextBlock Style="{StaticResource CardTitle}" Text="Sites" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="EmptyText" Style="{StaticResource Hint}" Margin="14,0,14,12"
                               Text="No live sites yet. Use + Add, or clone a site over FTP - its connections are saved here." Visibility="Collapsed" />
                    <ListBox x:Name="ProjectList" BorderThickness="0" SelectionChanged="ProjectList_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Padding" Value="12,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Editor" IsEnabled="False">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="FTP connection" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="110" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Host" Margin="0,0,0,4" />
                                    <TextBox x:Name="FtpHost" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Port" Margin="0,0,0,4" />
                                    <TextBox x:Name="FtpPort" />
                                </StackPanel>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="User" />
                                    <TextBox x:Name="FtpUser" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
                                    <c:PasswordInput x:Name="FtpPassword" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Remote path" />
                            <TextBox x:Name="FtpRemote" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource Primary}" Content="Save FTP connection" Click="SaveFtp_Click" />
                                <Button x:Name="TestFtpButton" Content="Test connection" Margin="8,0,0,0" Click="TestFtp_Click" />
                            </StackPanel>
                            <TextBlock x:Name="FtpStatus" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="SQL connection" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Server (host,port)" Margin="0,0,0,4" />
                            <TextBox x:Name="SqlServer" />
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Database name" />
                            <TextBox x:Name="SqlDatabase" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="User" />
                                    <TextBox x:Name="SqlUser" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Password" />
                                    <c:PasswordInput x:Name="SqlPassword" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource Primary}" Content="Save SQL connection" Click="SaveSql_Click" />
                                <Button x:Name="TestSqlButton" Content="Test connection" Margin="8,0,0,0" Click="TestSql_Click" />
                            </StackPanel>
                            <TextBlock x:Name="SqlStatus" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
