<Window x:Class="DnnManager.Presentation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:DnnManager.Presentation.Controls"
        Title="DNN Manager" Width="1180" Height="800" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextPrimary}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource SidebarBorder}" BorderThickness="0,0,1,0">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="20,22,20,18">
                <TextBlock Text="DNN Manager" Foreground="{DynamicResource SidebarTitle}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock x:Name="VersionText" Foreground="{DynamicResource SidebarMuted}" FontSize="12" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
                <Border Height="1" Background="{DynamicResource SidebarDivider}" Margin="18,0,18,8" />
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Settings" Checked="Nav_Checked" ToolTip="Edit appsettings.json">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource NavGlyph}" Text="&#xE713;" />
                        <TextBlock Text="Settings" />
                    </StackPanel>
                </RadioButton>
                <DockPanel Margin="20,10,12,0">
                    <Button DockPanel.Dock="Right" x:Name="ThemeButton" Style="{StaticResource SidebarIconButton}"
                            VerticalAlignment="Center" Margin="8,0,0,0" Click="Theme_Click">
                        <TextBlock x:Name="ThemeGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Projects folder" Foreground="{DynamicResource SidebarMuted}" FontSize="11" />
                        <TextBlock x:Name="BaseDirText" Foreground="{DynamicResource SidebarFg}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
            <StackPanel>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Projects" Checked="Nav_Checked" x:Name="NavProjects">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE8FD;" /><TextBlock Text="Projects" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Setup" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE710;" /><TextBlock Text="New project" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Existing" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE838;" /><TextBlock Text="Existing folder" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Clone" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE8C8;" /><TextBlock Text="Clone project" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Connections" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE774;" /><TextBlock Text="Live sites" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="Prerequisites" Checked="Nav_Checked">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource NavGlyph}" Text="&#xE9D9;" /><TextBlock Text="Prerequisites" /></StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>
        </Border>

        <!-- Page + activity log -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition x:Name="SplitterRow" Height="5" />
                <RowDefinition x:Name="LogRow" Height="230" MinHeight="90" />
            </Grid.RowDefinitions>

            <ContentControl x:Name="PageHost" Focusable="False" />

            <GridSplitter x:Name="LogSplitter" Grid.Row="1" HorizontalAlignment="Stretch" Background="{DynamicResource CardBorder}" />

            <DockPanel Grid.Row="2" Background="{DynamicResource LogBg}">
                <Border x:Name="LogHeader" DockPanel.Dock="Top" Background="{DynamicResource LogHeaderBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1" Padding="14,6">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource Danger}" MinHeight="24" Padding="10,2"
                                    Margin="0,0,8,0" Visibility="Collapsed" Click="Cancel_Click" />
                            <Button x:Name="CopyLogButton" Content="Copy" MinHeight="24" Padding="10,2" Margin="0,0,6,0" Click="CopyLog_Click"
                                    ToolTip="Copy the selected text, or the whole log when nothing is selected" />
                            <Button x:Name="ClearLogButton" Content="Clear" MinHeight="24" Padding="10,2" Click="ClearLog_Click" />
                            <Button x:Name="ToggleLogButton" MinHeight="24" Padding="8,2" Margin="6,0,0,0" ToolTip="Hide activity"
                                    Click="ToggleLog_Click">
                                <TextBlock x:Name="ToggleLogGlyph" Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" />
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Activity" Foreground="{DynamicResource LogHeaderFg}" FontWeight="SemiBold" Cursor="Hand"
                                       MouseLeftButtonUp="ToggleLog_Click" ToolTip="Show / hide activity" />
                            <TextBlock x:Name="RunningText" Foreground="{DynamicResource LogMuted}" Margin="12,0,10,0" />
                            <ProgressBar x:Name="BusyBar" Width="120" Height="4" IsIndeterminate="True" Visibility="Collapsed"
                                         Foreground="{DynamicResource Accent}" Background="{DynamicResource LogTrack}" BorderThickness="0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <!-- Read-only rich text: lines can be selected and copied (Ctrl+A / Ctrl+C, right-click → Copy). -->
                <c:LogView x:Name="LogList" Background="Transparent" BorderThickness="0"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                           Foreground="{DynamicResource LogFg}" SelectionBrush="{DynamicResource Accent}" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
